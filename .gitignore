# ── 私密:服务端模型密钥与访问码,绝不提交 ──
server_config.json
.env

# ── 内置 Google FX 运行时状态（账号名、积分、代理计数等）──
runtime/

# ── Python 缓存 ──
__pycache__/
*.pyc

# ── 日志 ──
# *.log 覆盖 server.log / server_stdout.log / server_stderr.log;
# 但轮转日志 server.log.1/2/3 的后缀是 .1/.2/.3(不是 .log),须单独列出。
*.log
server.log.*

# ── 运行时产物 / 临时文件 ──
server.pid
out.txt
stderr_crash.txt
server_boot_error.txt
packet_cache.json
process_brief_cache.json
compose_checkpoints.json
search_snippet_cache.json
*.json.tmp
# 写前备份轮换(如 library.json.bak / packet_cache.json.bak-YYYYMMDD)
*.bak
*.bak-*

# ── 用户数据(默认不提交)──
library.json
# 拆分存储形态的创意库(library/index.json + library/items/<id>.json),
# 与 library.json 同属用户数据;library.json.pre-split 是迁移前的原文件备份
library/
library.json.pre-split
library.rebuilt.json
topic_ledger.json
trend_refs.json
trend_refs.archive.json
outputs/
tasks/
tasks.json
# scratch/ 是目录形态；调试时更常见的是散落在仓库根的 scratch_xxx.json/.txt/.py
# 单文件（一次性核对脚本与其输出），此前没被忽略，长期挂在 git status 的未跟踪列表里。
scratch/
scratch_*

# ── 仓库根的媒体探针产物 ──
# ffmpeg 手工核对(音频瞬态检测、脉冲测试)会在仓库根落下 test_*.wav 之类的中间文件。
# 这类文件没有任何代码引用,却极易失控:实测出现过 4.0GB 的 test_audio.wav 和 2.6GB 的
# test_pulse.wav 一直挂在未跟踪列表里,离一次 `git add -A` 只差一步。
# 仓库里没有任何被跟踪的 .wav,整类忽略是安全的。
*.wav

# ── 一次性事故恢复留底(整份 manifest/创意库/媒体快照,体积大且是用户内容)──
.recovery/

# ── 工具 / 编辑器目录 ──
.claude/
.gemini/
.pytest_cache/
.DS_Store

# ── Python 虚拟环境:体积 200M+ 且含平台专属二进制(.pyd/.exe),
# Mac/Win 双机同步时互不可用。用 requirements.txt / pyproject.toml 重建。──
.venv/
venv/
